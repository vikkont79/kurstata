# Turso (SQLite через libSQL)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Секрет подписи JWT-сессий. Минимум 32 символа.
# Сгенерировать: openssl rand -base64 32
JWT_SECRET=generate-a-random-secret-at-least-32-chars

# Upstash Redis — rate limiting (обязательно). Взять в консоли upstash.com (REST API).
UPSTASH_REDIS_REST_URL=https://your-project.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Resend (email). Опционально: без ключа письма печатаются в консоль.
# В sandbox-режиме: from=onboarding@resend.dev, доставляются только на email аккаунта.
RESEND_API_KEY=re_xxxxxxxx
